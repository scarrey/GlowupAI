# Copy to .env and fill in. The .env file is gitignored.

# Required: secret used to sign JWT auth tokens (use a long random string)
JWT_SECRET=change_me_to_a_long_random_string

# Port the API listens on
PORT=3001

# Required for AI features (chat, tips, weekly report, product recommendations).
# Get a free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# LLM model to use via OpenRouter
AI_MODEL=google/gemini-2.0-flash-lite-001

# URL of the Python computer-vision microservice (cv-service)
CV_SERVICE_URL=http://localhost:8000
